# Non-secret template. Supply values using environment variables or an ignored
# SupportConfigFiles/.env file. Keep credentials outside Git.

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/online_pos_system
SPRING_DATASOURCE_USERNAME=pos_runtime
SPRING_DATASOURCE_PASSWORD=

# Server Configuration
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default
RUN_MIGRATION_SQL=true

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JWT Security
JWT_SECRET=
# At least 32 random characters. Migration and every runtime instance must match.
RLS_CONTEXT_SECRET=
SESSION_COOKIE_SECURE=true
APP_BASE_URL=https://email.crowdcam.co.za

# Password Reset Email Configuration
# A sending_access key is sufficient. MAIL_API remains a legacy fallback.
RESEND_API_KEY=
MAIL_API=
RESEND_FROM_EMAIL=noreply@email.crowdcam.co.za


# Google Maps browser key. Restrict by HTTP referrer and allow only Maps JavaScript API,
# Places API (New), and Maps Static API.
GOOGLE_MAPS_API_KEY=

# Separate migration owner. Use the restricted runtime account for normal queries.
MIGRATION_DATASOURCE_URL=jdbc:postgresql://localhost:5432/online_pos_system
MIGRATION_DATASOURCE_USERNAME=pos_owner
MIGRATION_DATASOURCE_PASSWORD=
RLS_RUNTIME_ROLE=pos_runtime

# Database setup remains available without deployment helpers:
# Run SQL files/provision-rls.sql with psql as the database administrator. It reads
# MIGRATION_DATASOURCE_* and SPRING_DATASOURCE_* credentials from the environment.
# Package the application with: ./Misc/mvnw -f Misc/pom.xml -Dmaven.test.skip=true package
# Run the migrate profile with owner datasource credentials, then run the default
# profile with the restricted runtime credentials. Preserve SQL migration checksums.
